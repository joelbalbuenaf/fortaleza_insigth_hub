# Fide con Claude. Sin esta variable, Fide funciona en "modo demo" (sin IA, respuestas calculadas localmente).
ANTHROPIC_API_KEY=
# Acceso al Hub: OBLIGATORIAS. El servidor no arranca sin ellas (el Hub muestra datos de socios).
HUB_USUARIO=
HUB_CLAVE=
# Firma de la cookie de sesión (opcional; si falta se deriva de las credenciales)
HUB_SECRETO=
# Opcionales
FIDE_MODEL=claude-opus-5
# low | medium | high | xhigh | max
FIDE_EFFORT=medium
